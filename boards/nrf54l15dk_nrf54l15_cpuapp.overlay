#include "../common/common-pinctrl.dtsi"

&uart20 {
	status = "disabled";
};

&nfct {
	status = "disabled";
};
&uicr {
    nfct-pins-as-gpios;
};

&spi00 {
	status = "disabled";
};
&spi20 {
	status = "disabled";
};
&spi21 {
    status = "okay";
    pinctrl-0 = <&spi21_default>;
    pinctrl-1 = <&spi21_sleep>;
    pinctrl-names = "default", "sleep";
    max-frequency = <DT_FREQ_M(16)>;
};

&pinctrl {
    spi21_default: spi21_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MISO, 2, 9)>,
                    <NRF_PSEL(SPIM_SCK, 2, 6)>,
                    <NRF_PSEL(SPIM_MOSI, 2, 8)>;
        };
    };

    spi21_sleep: spi21_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MISO, 2, 9)>;
        };
    };
};